# ─────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────
# Database (PostgreSQL / Prisma)
# ─────────────────────────────────────────
# Connection pool URL (e.g. for Supabase, Neon, or local Docker)
DATABASE_URL="postgresql://taskflow:taskflow123@localhost:5432/taskflow_dev?schema=public"
# Direct database URL for migrations
DIRECT_URL="postgresql://taskflow:taskflow123@localhost:5432/taskflow_dev?schema=public"

# ─────────────────────────────────────────
# Authentication & Security (JWT)
# ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# ─────────────────────────────────────────
# Redis (BullMQ Queues & Workers)
# ─────────────────────────────────────────
# For remote/cloud Redis (Upstash)
# REDIS_URL=rediss://default:your_token@your_redis_host:6379
# For local Redis / Docker
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────
# Email Service (Resend)
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=TaskFlow <onboarding@resend.dev>

# ─────────────────────────────────────────
# Billing & Payments (Stripe)
# ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_ID=price_your_stripe_pro_subscription_price_id
