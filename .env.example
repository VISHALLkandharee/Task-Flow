# ─────────────────────────────────────────
# TaskFlow Monorepo Root Environment Configuration
# ─────────────────────────────────────────

# Database
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow123
POSTGRES_DB=taskflow_dev
DATABASE_URL=postgresql://taskflow:taskflow123@postgres:5432/taskflow_dev?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
CLIENT_URL=http://localhost:3000

# External Integrations (Optional for local testing / Mocked in test suites)
RESEND_API_KEY=re_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key
STRIPE_PRICE_ID=price_placeholder_key

# Client
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
